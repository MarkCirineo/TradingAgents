# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Data Providers (optional, for social sentiment)
FINNHUB_API_KEY=

# Alpaca Paper Trading
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Daemon LLM config (override defaults for autonomous trading)
# Set these to configure the daemon without interactive prompts.
# Example for NVIDIA NIM:
#   LLM_PROVIDER=nvidia
#   DEEP_THINK_LLM=mistralai/mistral-medium-3.5-128b
#   QUICK_THINK_LLM=mistralai/mistral-small-4-119b-2603
#   BACKEND_URL=https://integrate.api.nvidia.com/v1
LLM_PROVIDER=
DEEP_THINK_LLM=
QUICK_THINK_LLM=
BACKEND_URL=

# Pipeline mode for A/B testing
# "full" = LLM analysis pipeline gates entries (default)
# "quant" = quantitative-only, skip LLM, auto-buy if pre-filter passes
PIPELINE_MODE=full

# Screening (how many tickers to scan and analyze)
# SCREENING_SOURCE=hybrid       # alpaca | yfinance | watchlist | hybrid
# MAX_CANDIDATES=35
# MAX_PIPELINE_RUNS=15
# MAX_WORKERS=2
# YF_SCREENER_MAX_RESULTS=100   # Yahoo Finance whole-market screen depth

# Alpaca market-data feeds
# Daily/historical bars default to SIP (consolidated tape, 15-min delayed on
# the free plan) — IEX bars understate volume ~20x and narrow ADR ranges.
# Real-time data (snapshots, intraday bars) defaults to IEX (free, no delay).
# ALPACA_DAILY_FEED=sip
# ALPACA_DATA_FEED=iex

# Override database path (useful when running two daemon instances)
# Each instance should use a different DB file to avoid write contention.
# TRADINGAGENTS_DB_PATH=~/.tradingagents/trades_full.db

# Dashboard settings (defaults to 0.0.0.0:8050)
# In production, bind to 127.0.0.1 so only NGINX can reach it
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8051

# A/B comparison: point to the other instance's dashboard
# PEER_DASHBOARD_URL=http://localhost:8051
# INSTANCE_LABEL=Full LLM
# PEER_LABEL=Quant Only

# Discord notifications (optional — leave blank to disable)
# Create a webhook: Server Settings → Integrations → Webhooks → New Webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
